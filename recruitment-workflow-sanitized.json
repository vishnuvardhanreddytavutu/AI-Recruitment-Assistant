        "responses": {
          "values": [
            {
              "content": "=Job Description:\n{{ $('On form submission').item.json.JD }}\n\nResume Text:\n{{ $json.text }}\n\nExtract the candidate's name and a list of their skills from the resume. Compare skills against the JD and give a match_score from 0-100.\n\nReturn ONLY valid JSON, no markdown, no code fences:\n{\"name\": \"candidate name\", \"skills\": [\"skill1\", \"skill2\"], \"match_score\": 75}"
            }
          ]
        },
        "builtInTools": {},
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 2.3,
      "position": [
        544,
        -160
      ],
      "id": "6515908b-5c30-4b6a-bc23-03c7bafdde7a",
      "name": "Message a model"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const raw = $json.output[0].content[0].text;\nconst cleaned = raw.replace(/```json|```/g, '').trim();\nconst parsed = JSON.parse(cleaned);\n\nreturn {\n  json: {\n    name: parsed.name,\n    skills: parsed.skills.join(', '),\n    match_score: parsed.match_score\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
