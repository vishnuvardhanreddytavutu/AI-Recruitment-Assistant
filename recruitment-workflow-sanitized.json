    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\n// Remove duplicate candidates by Name (keep only the first occurrence)\nconst seen = new Set();\nconst unique = items.filter(item => {\n  const name = item.json['Name'];\n  if (seen.has(name)) return false;\n  seen.add(name);\n  return true;\n});\n\n// Sort by Match Score, descending\nconst sorted = unique.sort((a, b) => b.json['Match Score'] - a.json['Match Score']);\n\n// Assign rank\nreturn sorted.map((item, index) => ({\n  json: {\n    ...item.json,\n    Rank: index + 1\n  }\n}));"
      },
      "type": "n8n-nodes-base.code",
